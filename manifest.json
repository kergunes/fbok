{
  "manifest_version": 3,
  "name": "fbok",
  "version": "0.1.12",
  "description": "Detects Facebook Sponsored / Sponsorlu / Ad feed posts and hides only high-confidence matches.",
  "host_permissions": [
    "https://facebook.com/*",
    "https://www.facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://facebook.com/*",
        "https://www.facebook.com/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/debug.css"],
      "run_at": "document_idle"
    }
  ]
}
